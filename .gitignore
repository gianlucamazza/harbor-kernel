/target/
/kernel8.img
**/*.elf
**/*.o

# Fetched platform firmware (regenerate with `make blobs`)
/third_party/blobs/start4.elf
/third_party/blobs/fixup4.dat
/third_party/blobs/MANIFEST.txt

# Local SD backups (Pi OS / previous Harbor images)
/.sd-backup/

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store

# cargo-mutants scratch output
/mutants.out/
/mutants.out.old/

# Serial transcripts (scripts/serial.sh) are working artifacts. The tracked
# record derived from them lives in docs/evidence/ (ADR-0109).
/.serial-log/

# ...and it has to be un-ignored explicitly, because a global excludes file is
# allowed to say `*.log` and this repository's records are `.log`. Found the
# hard way: `git add -A` staged the two pcaps and silently skipped all 36
# transcripts, which would have left CI red on every citation with the files
# sitting right there on disk. A repository's own .gitignore wins over the
# user's, so the negation belongs here rather than in anyone's home directory.
!docs/evidence/*.log
